# Copy to .env (git-ignored) and adjust. Boot fails fast if anything here is invalid.

# --- API ---------------------------------------------------------------------
PORT=3000
# Largest CSV upload accepted, in bytes (default 25 MiB; allowed 1 KiB to 100 MiB).
IMPORT_MAX_BYTES=26214400

# --- Infra (matches docker-compose.yml) --------------------------------------
DATABASE_URL=postgres://ziro:ziro_dev@localhost:5433/ziro
REDIS_URL=redis://localhost:6379

# --- Razorpay (TEST MODE ONLY) -----------------------------------------------
# synthetic = generated data, no keys needed. testmode = Razorpay test API; keys required.
# Boot refuses any RAZORPAY_KEY_ID starting with rzp_live_.
RAZORPAY_SOURCE=synthetic
# Generated by: npm run datagen -- --seed 42 --preset demo --out data/demo
# Used when RAZORPAY_SOURCE=synthetic, and in testmode for what test mode has no data for.
SYNTHETIC_DATA_DIR=data/demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Model layer (docs/DECISIONS.md ADR-018) ----------------------------------
# Provider-agnostic: Gemini's free tier first, Claude optional. Nothing here is required to boot. With no
# usable model the agent is off and the rules, the review console and the replay still work.
#
# SYNTHETIC DATA ONLY on a free-tier key: Google may use what is sent to improve its products, and people
# may read it. Never point a real merchant's records at it.
GEMINI_API_KEY=
# free = the key has daily request limits and costs nothing. paid = it is billed (then LLM_PRICES must price it).
GEMINI_TIER=free
# Optional. A funded Anthropic account only; an empty or credit-less key just drops Claude from the chain.
ANTHROPIC_API_KEY=
# The models, in the order they are tried: provider:model, comma separated. Model ids live ONLY here.
# A model falls back to the next on quota, billing, a bad key, a timeout, a server error or a long rate limit.
# The first Gemini entry is "lite", the second "flash" and the first Anthropic entry "claude" in the evals.
LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash,anthropic:claude-haiku-5-5
# Free-tier request limits per model, copied BY YOU from aistudio.google.com/rate-limit (they differ by
# account and change). Never guessed in code. Without an entry the app warns at boot and relies on the
# server's own 429s. Shape: {"<model id>": {"rpm": <requests/minute>, "rpd": <requests/day>}}
GEMINI_LIMITS=
# Paid list prices per provider:model, USD per million tokens, copied BY YOU from the price pages. Used for
# the "estimated cost at paid prices" column and to count Claude's spend; a paid model with no price is
# left out of the chain. Shape: {"anthropic:<model id>": {"input": "<usd>", "output": "<usd>"}}
LLM_PRICES=
# off = every call goes to the provider. record = also keep each answer (Postgres table llm_cache).
# replay = answers come from that record only; a call that is not in it FAILS. Replays are labelled as such.
LLM_CACHE=off
# Where the evals keep the record, since each eval run builds a fresh in-memory database.
LLM_CACHE_FILE=data/llm-cache.jsonl
# single-shot = the harness gathers the evidence and makes ONE structured call (fewest requests).
# loop = the model drives read-only tools, at most LLM_MAX_TOOL_CALLS of them.
AGENT_HARNESS=single-shot
LLM_MAX_TOOL_CALLS=4
# The longest a rate limit is waited out before the next model is tried.
LLM_MAX_WAIT_SECONDS=30

# --- Review / auto-accept ----------------------------------------------------
AUTO_ACCEPT_ENABLED=false
# Integer paise (100000 = Rs 1,000.00). Never a decimal.
AUTO_ACCEPT_MAX_PAISE=100000
# Auto-accept also needs at least this much confidence (0 to 1) from the agent.
AUTO_ACCEPT_MIN_CONFIDENCE=0.85

# --- Demo and spend guards ---------------------------------------------------
DEMO_MODE=true
DAILY_LLM_BUDGET_USD=5
# true = no LLM calls at all, whatever else is set
AGENT_KILL_SWITCH=false

# --- Investigation agent -----------------------------------------------------
# Related exceptions (sharing candidates) are investigated in one conversation when true.
CLUSTER_EXCEPTIONS=false
# On: give an unsure answer one second look from the NEXT model in LLM_CHAIN. Off by default: on the free
# tier every extra look spends the scarce daily requests (fallback, which is about availability, is separate).
AGENT_ESCALATION=false
# On: build the featured demo and eval runs in the background at boot if they are missing.
DEMO_SEED_ON_BOOT=true
# On: this process also runs the investigation worker. Off: it only enqueues jobs.
AGENT_WORKER_ENABLED=true
# Investigations in flight at once (1 to 32).
AGENT_CONCURRENCY=4

# --- Public demo limits (DEMO_MODE) --------------------------------------------
# Per rolling hour; 0 refuses all. Held in this process, so exact with one instance (deploy uses max 1).
DEMO_LIVE_RUNS_PER_IP_HOUR=5
DEMO_LIVE_RUNS_PER_HOUR=30
DEMO_RUNS_PER_IP_HOUR=20
DEMO_RUNS_PER_HOUR=200

# --- Logs ----------------------------------------------------------------------
# json = pino default. gcp = Cloud Logging fields (severity, message, trace).
LOG_FORMAT=json
LOG_LEVEL=info
# Only used to build the trace field of a gcp log line.
GCP_PROJECT_ID=

