# Copy to .env (git-ignored) and adjust. Boot fails fast if anything here is invalid.

# --- API ---------------------------------------------------------------------
PORT=3000
# Largest CSV upload accepted, in bytes (default 25 MiB; allowed 1 KiB to 100 MiB).
IMPORT_MAX_BYTES=26214400

# --- Infra (matches docker-compose.yml) --------------------------------------
DATABASE_URL=postgres://ziro:ziro_dev@localhost:5433/ziro
REDIS_URL=redis://localhost:6379

# --- Razorpay (TEST MODE ONLY) -----------------------------------------------
# synthetic = generated data, no keys needed. testmode = Razorpay test API; keys required.
# Boot refuses any RAZORPAY_KEY_ID starting with rzp_live_.
RAZORPAY_SOURCE=synthetic
# Generated by: npm run datagen -- --seed 42 --preset demo --out data/demo
# Used when RAZORPAY_SOURCE=synthetic, and in testmode for what test mode has no data for.
SYNTHETIC_DATA_DIR=data/demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Agent (Anthropic) -------------------------------------------------------
# Optional at boot: the free demo replay works without a key. Checked when an agent run starts.
ANTHROPIC_API_KEY=
# Model IDs come from env only. Each must have a price in apps/api/src/agent/pricing.ts, or the app
# refuses to start with a key set (so spend is always counted). The agent is off without a key.
AGENT_MODEL_SMALL=claude-haiku-5-5
AGENT_MODEL_LARGE=claude-sonnet-5-5
# loop = hand-rolled tool-use loop on @anthropic-ai/sdk (harness A). agent-sdk = the Claude Agent SDK (harness B):
# one model (AGENT_MODEL_SMALL), no escalation. packages/evals compares the two.
AGENT_HARNESS=loop

# --- Review / auto-accept ----------------------------------------------------
AUTO_ACCEPT_ENABLED=false
# Integer paise (100000 = Rs 1,000.00). Never a decimal.
AUTO_ACCEPT_MAX_PAISE=100000
# Auto-accept also needs at least this much confidence (0 to 1) from the agent.
AUTO_ACCEPT_MIN_CONFIDENCE=0.85

# --- Demo and spend guards ---------------------------------------------------
DEMO_MODE=true
DAILY_LLM_BUDGET_USD=5
# true = no LLM calls at all, whatever else is set
AGENT_KILL_SWITCH=false

# --- Investigation agent -----------------------------------------------------
# Related exceptions (sharing candidates) are investigated in one conversation when true.
CLUSTER_EXCEPTIONS=false
# On: retry once on AGENT_MODEL_LARGE when the small model is unsure or gives up.
AGENT_ESCALATION=true
# On: build the featured demo and eval runs in the background at boot if they are missing.
DEMO_SEED_ON_BOOT=true
# On: this process also runs the investigation worker. Off: it only enqueues jobs.
AGENT_WORKER_ENABLED=true
# Investigations in flight at once (1 to 32).
AGENT_CONCURRENCY=4

# --- Public demo limits (DEMO_MODE) --------------------------------------------
# Per rolling hour; 0 refuses all. Held in this process, so exact with one instance (deploy uses max 1).
DEMO_LIVE_RUNS_PER_IP_HOUR=5
DEMO_LIVE_RUNS_PER_HOUR=30
DEMO_RUNS_PER_IP_HOUR=20
DEMO_RUNS_PER_HOUR=200

# --- Logs ----------------------------------------------------------------------
# json = pino default. gcp = Cloud Logging fields (severity, message, trace).
LOG_FORMAT=json
LOG_LEVEL=info
# Only used to build the trace field of a gcp log line.
GCP_PROJECT_ID=

