{
  "name": "@ziro/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free, IO-free reconciliation core: money, domain, normalize, matcher, verifier.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./matcher": {
      "types": "./dist/matcher/index.d.ts",
      "default": "./dist/matcher/index.js"
    },
    "./normalize": {
      "types": "./dist/normalize/index.d.ts",
      "default": "./dist/normalize/index.js"
    },
    "./razorpay": {
      "types": "./dist/razorpay/index.d.ts",
      "default": "./dist/razorpay/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./verify": {
      "types": "./dist/verify/index.d.ts",
      "default": "./dist/verify/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
