# Non-secret settings of the public demo. Read by scripts/docker-local.sh (docker --env-file) and by
# scripts/deploy.sh (turned into Cloud Run env vars), so the two cannot drift. NO secrets here: the
# database and Redis URLs and the API key come from Secret Manager (docs/DEPLOY.md). One KEY=VALUE per line,
# no quotes, no commas inside a value.

# --- what the demo is ---------------------------------------------------------------------------------------
DEMO_MODE=true
# synthetic = generated data, no Razorpay keys needed. Boot refuses any rzp_live_ key in any case.
RAZORPAY_SOURCE=synthetic
# Where the demo generates its data at run time (apps/api/src/demo/dataset.ts): the temp directory.
SYNTHETIC_DATA_DIR=/tmp/ziro-demo-data/demo-42

# --- the agent -------------------------------------------------------------------------------------------------
AGENT_HARNESS=loop
AGENT_MODEL_SMALL=claude-haiku-5-5
AGENT_MODEL_LARGE=claude-sonnet-5-5
AGENT_ESCALATION=true
CLUSTER_EXCEPTIONS=false
AUTO_ACCEPT_ENABLED=false
AUTO_ACCEPT_MAX_PAISE=0
AGENT_KILL_SWITCH=false
# The investigation queue worker is OFF: the demo's live path runs the agent in this process, and BullMQ
# polls Redis even when idle, which Upstash bills per command (docs/DEPLOY.md).
AGENT_WORKER_ENABLED=false
AGENT_CONCURRENCY=4

# --- spend and abuse limits ------------------------------------------------------------------------------------
# A global daily cap on model spend, summed from the database (so it holds across restarts).
DAILY_LLM_BUDGET_USD=2
DEMO_LIVE_RUNS_PER_IP_HOUR=5
DEMO_LIVE_RUNS_PER_HOUR=30
DEMO_RUNS_PER_IP_HOUR=20
DEMO_RUNS_PER_HOUR=200

# --- the deploy job builds the featured runs; the service does not ------------------------------------------
DEMO_SEED_ON_BOOT=false

# --- logs --------------------------------------------------------------------------------------------------------
LOG_FORMAT=gcp
LOG_LEVEL=info
